# Copy this file to .env and fill in the password. .env is ignored by git; this template is not.

# The connection string exactly as Atlas shows it (Connect > Drivers). Leave <db_password> as it is.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<your-cluster>.mongodb.net/

# The password of the Atlas *database user* (Atlas > Security > Database Access).
MONGODB_PASSWORD=

# Database the CRM collections are created in.
MONGODB_DB=crm
