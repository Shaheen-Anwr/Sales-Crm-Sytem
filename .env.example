# Optional settings for `docker compose`. To use them, copy this file to .env in
# this folder (next to compose.yaml) and uncomment the lines you need.
# In .env, write a $ as $$ (compose reads $ as the start of a variable).

# Use MongoDB Atlas instead of the local MongoDB container. Paste the connection
# string as Atlas shows it, keeping <db_password>, and put the password below.
# MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<your-cluster>.mongodb.net/
# MONGODB_PASSWORD=
# MONGODB_DB=crm

# Skip loading api/data/*.csv into MongoDB when the API starts (e.g. Atlas already has the data).
# SEED_DATA=false

# Django's secret key. The built-in one is fine on your own machine.
# DJANGO_SECRET_KEY=
